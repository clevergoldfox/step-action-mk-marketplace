{
  "name": "mk/mk-marketplace",
  "description": "C2C marketplace money layer: Stripe Connect escrow, dual-rate fees, transfers, reversals and netting.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "stripe/stripe-php": "^17.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "MK\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MK\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
